# Copy this file to .devcontainer/.env and fill in real values.
# .env is gitignored (see .gitignore) — never commit it.
#
# No quotes around values — Docker's --env-file parser doesn't strip them,
# so "http://..." (with quotes) becomes part of the literal value.
#
# Use ONE of these, not both:
#   LAN, on the home network:      HA_URL=http://192.168.86.x:8123
#   Nabu Casa, from anywhere:      HA_URL=https://xxxxxxxx.ui.nabu.casa
# (Nabu Casa URLs are https with no port — unlike the LAN example above.)
HA_URL=http://192.168.86.x:8123

# Create this under a dedicated, non-admin Home Assistant user if you can
# (Settings -> People -> Users -> add one, then generate its token from
# that user's own profile). A long-lived token carries whatever access its
# owning user has, and every process in this container — including Claude
# Code — can read it; scoping it down means it's only worth as much as it
# needs to be, not as much as your own admin account.
# HA Profile -> Security -> Long-Lived Access Tokens
HA_TOKEN=<long-lived access token>
